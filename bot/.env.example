DISCORD_TOKEN=paste-your-bot-token-here
# Firebase Realtime DB URL (same one baked into the hub). The primary global store — the bot reads every account from here.
FIREBASE_URL=https://your-db-default-rtdb.firebaseio.com/
# Optional legacy fallback: the shared stats channel webhook. Only used for accounts still on the old (pre-DB) hub.
STATS_WEBHOOK=https://discord.com/api/webhooks/xxxx/xxxx
